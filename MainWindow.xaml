<Window x:Class="DesktopIncenseBurner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Desktop Incense Burner"
        Width="360" Height="420" MinWidth="260" MinHeight="300"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip" ShowInTaskbar="True"
        Topmost="True" Loaded="Window_Loaded" Closing="Window_Closing">
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="上香" Click="LightIncense_Click"/>
            <MenuItem Header="暂停 / 继续" Click="Pause_Click"/>
            <Separator/>
            <MenuItem Header="设置…" Click="Settings_Click"/>
            <MenuItem Header="退出" Click="Exit_Click"/>
        </ContextMenu>
    </Window.ContextMenu>
    <Grid>
        <Border x:Name="MainBorder" CornerRadius="22" Background="#E91B1714"
                BorderBrush="#B77D3E" BorderThickness="1.2"
                MouseLeftButtonDown="MainBorder_MouseLeftButtonDown">
            <Grid ClipToBounds="True">
                <Canvas x:Name="SceneCanvas" IsHitTestVisible="False"/>
                <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,12,0,0">
                    <TextBlock Text="DESKTOP INCENSE" Foreground="#E8C99B"
                               FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="StatusText" Text="香火安宁" Foreground="#E8D7C2"
                               FontSize="12" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                            VerticalAlignment="Bottom" Margin="8,0,8,14">
                    <Button Content="上香" Click="LightIncense_Click" Margin="4,0"
                            Padding="13,6" Background="#8D5B31" Foreground="White" BorderThickness="0"/>
                    <Button x:Name="PauseButton" Content="暂停" Click="Pause_Click" Margin="4,0"
                            Padding="13,6" Background="#594638" Foreground="White" BorderThickness="0"/>
                    <Button Content="设置" Click="Settings_Click" Margin="4,0"
                            Padding="13,6" Background="#594638" Foreground="White" BorderThickness="0"/>
                </StackPanel>
                <TextBlock x:Name="TimerText" Text="尚未上香" Foreground="#E8D7C2"
                           FontSize="11" HorizontalAlignment="Center"
                           VerticalAlignment="Bottom" Margin="0,0,0,55"/>
            </Grid>
        </Border>
    </Grid>
</Window>
