<Window x:Class="DesktopIncenseBurner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Desktop Incense Burner"
        Width="360" Height="420" MinWidth="260" MinHeight="300"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="True"
        Topmost="False" Loaded="Window_Loaded" Closing="Window_Closing"
        Deactivated="Window_Deactivated" SizeChanged="Window_SizeChanged"
        MouseLeave="Window_MouseLeave">
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="上香" Click="LightIncense_Click"/>
            <MenuItem Header="暂停 / 继续" Click="Pause_Click"/>
            <Separator/>
            <MenuItem Header="设置…" Click="Settings_Click"/>
            <MenuItem Header="退出" Click="Exit_Click"/>
        </ContextMenu>
    </Window.ContextMenu>
    <Grid>
        <Border x:Name="MainBorder" CornerRadius="22" Background="Transparent"
                BorderBrush="Transparent" BorderThickness="0"
                MouseLeftButtonDown="MainBorder_MouseLeftButtonDown">
            <Grid ClipToBounds="True">
                <Canvas x:Name="SceneCanvas" IsHitTestVisible="False"/>
                <!-- 默认隐藏标题与状态文字，让香炉成为唯一视觉主体。 -->
                <TextBlock x:Name="StatusText" Visibility="Collapsed"/>
                <StackPanel x:Name="ControlPanel" Orientation="Horizontal" HorizontalAlignment="Center"
                            VerticalAlignment="Bottom" Margin="8,0,8,14" Visibility="Collapsed">
                    <Button Click="LightIncense_Click" Margin="5,0" Width="36" Height="36"
                            Padding="0" Background="#95652D" Foreground="#FFF2D5" BorderThickness="0"
                            ToolTip="上香" ToolTipService.InitialShowDelay="250">
                        <TextBlock Text="♨" FontFamily="Segoe UI Symbol" FontSize="19"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button x:Name="PauseButton" Content="Ⅱ" Click="Pause_Click" Margin="5,0"
                            Width="36" Height="36" Padding="0" Background="#594638"
                            Foreground="#FFF2D5" BorderThickness="0"
                            ToolTip="暂停 / 继续" ToolTipService.InitialShowDelay="250"
                            FontFamily="Segoe UI Symbol" FontSize="17"/>
                    <Button Click="Settings_Click" Margin="5,0" Width="36" Height="36"
                            Padding="0" Background="#594638" Foreground="#FFF2D5" BorderThickness="0"
                            ToolTip="设置" ToolTipService.InitialShowDelay="250">
                        <TextBlock Text="⚙" FontFamily="Segoe UI Symbol" FontSize="18"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
                <TextBlock x:Name="TimerText" Visibility="Collapsed"/>
                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Width="22" Height="22" Margin="0,0,2,2"
                        Background="#B98B48" CornerRadius="3,0,18,0"
                        Opacity="0.9" IsHitTestVisible="False"/>
                <Thumb x:Name="ResizeThumb" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       Width="22" Height="22" Cursor="SizeNWSE" Background="Transparent"
                       DragDelta="ResizeThumb_DragDelta" ToolTip="拖动此处调整香炉大小"/>
            </Grid>
        </Border>
    </Grid>
</Window>