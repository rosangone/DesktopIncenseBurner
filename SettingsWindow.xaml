<Window x:Class="DesktopIncenseBurner.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="香炉设置" Width="360" Height="540" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#211B17"
        Foreground="#F2E4D3">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="古韵铜炉 · 桌面设置" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="香炉铭文（可自定义）"/>
                <TextBox x:Name="InscriptionBox" MaxLength="12" Margin="0,5,0,12"
                         ToolTip="例如：招财进宝、平安喜乐、福寿安康"/>
                <TextBlock Text="窗口尺寸（宽 × 高，像素）"/>
                <Grid Margin="0,5,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="WidthBox" Grid.Column="0"/>
                    <TextBlock Grid.Column="1" Text="×" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <TextBox x:Name="HeightBox" Grid.Column="2"/>
                </Grid>
                <TextBlock Text="同时点燃香支数量"/>
                <ComboBox x:Name="CountBox" Margin="0,5,0,12">
                    <ComboBoxItem Content="1 支" Tag="1"/>
                    <ComboBoxItem Content="2 支" Tag="2"/>
                    <ComboBoxItem Content="3 支" Tag="3"/>
                </ComboBox>
                <TextBlock Text="预计燃烧时间（分钟）"/>
                <TextBox x:Name="MinutesBox" Margin="0,5,0,12"/>
                <TextBlock Text="烟雾浓度"/>
                <Slider x:Name="DensitySlider" Minimum="10" Maximum="90" TickFrequency="5"
                        IsSnapToTickEnabled="True" Margin="0,5,0,12"/>
                <TextBlock Text="烟雾速度"/>
                <Slider x:Name="SpeedSlider" Minimum="0.3" Maximum="2.5" Margin="0,5,0,12"/>
                <TextBlock Text="窗口透明度"/>
                <Slider x:Name="OpacitySlider" Minimum="0.35" Maximum="1" Margin="0,5,0,12"/>
                <CheckBox x:Name="TopmostCheck" Content="始终置顶（开启后会覆盖浏览器等窗口）" Margin="0,4,0,10"/>
                <TextBlock Text="关闭始终置顶时，香炉会停留在桌面层，普通窗口可覆盖它。"
                           Foreground="#C7B49E" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,8"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="取消" Width="76" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="保存" Width="76" Background="#986337" Foreground="White"
                    BorderThickness="0" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>